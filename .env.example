# ==============================================================================
# Gen UI (GenUI API Explorer) — Environment Variables Configuration
# Copy this file to .env.local and populate the values for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
# PostgreSQL connection string. If using the provided docker-compose:
DATABASE_URL=postgres://genui:genui_pass@localhost:5432/genui_db

# ------------------------------------------------------------------------------
# 2. Key Vault Security & Encryption
# ------------------------------------------------------------------------------
# Secret master passphrase for AES-256-GCM encryption of stored user API keys.
# Must be kept safe. Changing this invalidates all previously stored encrypted keys.
GENUI_VAULT_PASSPHRASE=replace-with-a-secure-32-character-passphrase-here

# ------------------------------------------------------------------------------
# 3. Authentication (NextAuth.js v5 / Auth.js)
# ------------------------------------------------------------------------------
# Secret token used by NextAuth to sign JWT tokens (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-random-secret-at-least-32-characters-long

# GitHub OAuth credentials (create at: https://github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret

# ------------------------------------------------------------------------------
# 4. LLM Providers (Vercel AI SDK v4)
# ------------------------------------------------------------------------------
# Provider to activate by default: 'google' | 'anthropic' | 'openai'
GENUI_LLM_PROVIDER=google

# Google Gemini API Key (https://aistudio.google.com/)
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...

# Anthropic Claude API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI GPT-4o API Key (https://platform.openai.com/)
OPENAI_API_KEY=sk-proj-...

# ------------------------------------------------------------------------------
# 5. Rate Limiting (Optional - Upstash Redis)
# ------------------------------------------------------------------------------
# If omitted, proxy rate limiting gracefully falls back to permissive in-memory execution.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
